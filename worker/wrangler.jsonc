{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "serck-david-chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash"
  }
}
